# Copy to .env and fill in. Never commit .env.
# Production values come from the hosting platform's secret manager, under the same names.

# App
NODE_ENV=development
RINGER_BASE_URL=
SESSION_SECRET=

# Database
DATABASE_URL=

# Telephony (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_OUTBOUND_NUMBER=

# Safety ceiling on calls per run (user picks the actual number per run)
MAX_CALLS_PER_RUN=

# Voice agent (ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Extraction / checkpoint LLM
LLM_API_KEY=

# Vendor discovery (e.g. Google Places)
PLACES_API_KEY=

# Board tool (Kolaboreyt)
KOLABOREYT_API_KEY=
KOLABOREYT_BASE_URL=

# Notifications (email)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# ChatGPT app / OAuth account linking
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Billing (Phase 4)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Assistant inboxes (per-user inbound email + SMS)
ASSISTANT_EMAIL_DOMAIN=
INBOUND_EMAIL_WEBHOOK_SECRET=
