# Copy to .env and fill in. Never commit .env.
# Production values come from the hosting platform's secret manager, under the same names.
# Everything defaults to "fake" providers, so `npm run dev` works with no keys at all.

# --- App ---
NODE_ENV=development
PORT=8787
RINGER_BASE_URL=http://localhost:8787
# Signs approval and board links. Required in production (long random string).
LINK_SIGNING_SECRET=

# --- Database ---
# Empty = embedded Postgres (PGlite), persisted in PGLITE_DATA_DIR.
DATABASE_URL=
PGLITE_DATA_DIR=.pglite

# --- Provider switches ---
# VOICE_PROVIDER: fake | elevenlabs
VOICE_PROVIDER=fake
# NUMBER_PROVIDER: fake | twilio
NUMBER_PROVIDER=fake
# PLACES_PROVIDER: fake | google
PLACES_PROVIDER=fake
# EXTRACTOR_PROVIDER: fake | anthropic
EXTRACTOR_PROVIDER=fake
# MAIL_PROVIDER: console | resend
MAIL_PROVIDER=console
# BOARD_PROVIDER: local | kolaboreyt
BOARD_PROVIDER=local

# --- Telephony: per-user assistant numbers (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_AU_ADDRESS_SID=
TWILIO_AU_BUNDLE_SID=

# --- Voice agent (ElevenLabs) ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=

# --- Transcript extraction (Claude) ---
ANTHROPIC_API_KEY=
EXTRACTOR_MODEL=claude-opus-5

# --- Vendor verification (Google Places) ---
# Used only after the user agrees to use Ringer: checks the businesses their
# assistant found (closed? real phone? hours?). Ringer never searches itself.
PLACES_API_KEY=
VERIFY_MAX_AGE_DAYS=14
PLACES_LOOKUPS_PER_USER_PER_DAY=40

# --- Board (Kolaboreyt) ---
KOLABOREYT_API_KEY=
KOLABOREYT_BASE_URL=

# --- Email (reports, Needs-you) ---
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=Ringer <reports@example.com>

# --- Assistant inboxes (per-user inbound email + SMS) ---
ASSISTANT_EMAIL_DOMAIN=assist.example.com
INBOUND_EMAIL_WEBHOOK_SECRET=

# --- Product rules ---
# Safety ceiling on calls per run (the user picks the actual number per run).
MAX_CALLS_PER_RUN=12
PILOT_MINUTES=600
NEEDS_YOU_TIMEOUT_MINUTES=120

# --- Later phases (not read yet) ---
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
